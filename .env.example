# Lấy API key tại https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_api_key_here

# Tên model. Nếu "gemini-3.0-pro" chưa available với key của bạn,
# thử: gemini-2.5-pro, gemini-2.5-flash, gemini-2.0-flash
GEMINI_MODEL=gemini-3.0-pro

# Database
DATABASE_URL=postgresql+psycopg2://aifb_admin:aifb_secret@localhost:5432/aifb_vision

# Giới hạn upload (MB)
MAX_IMAGE_MB=10

# Timeout gọi Gemini (giây)
REQUEST_TIMEOUT_S=60

# CORS - đặt domain app mobile nếu cần, mặc định "*" cho dev
ALLOWED_ORIGINS=*

# Giới hạn audio upload (MB)
MAX_AUDIO_MB=10

# Giọng đọc edge-tts (tiếng Việt: vi-VN-HoaiMyNeural | vi-VN-NamMinhNeural)
TTS_VOICE=vi-VN-HoaiMyNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz

# ── Backend: Nhận dạng tiền VNĐ (backend/services/money_service.py) ──
# Đường dẫn model YOLO nhận dạng mệnh giá tiền (tùy chọn).
# Nếu để trống/không tồn tại, backend tự động dùng Gemini VLM.
VND_YOLO_MODEL_PATH=./models/yolo/vnd_yolov8n.pt

# Ngưỡng độ tin cậy khi nhận dạng tiền (0.0 – 1.0)
MONEY_CONFIDENCE=0.5

# ── Backend: Truy hồi thông tin Internet (backend/services/ir_service.py) ──
# Số kết quả mặc định cho POST /search
SEARCH_DEFAULT_N=5

# Thư mục cache tin tức RSS (backend đọc lại sau NEWS_REFRESH_HOURS giờ)
NEWS_CACHE_DIR=./data/news_cache

# Chu kỳ làm mới cache tin tức (giờ)
NEWS_REFRESH_HOURS=6


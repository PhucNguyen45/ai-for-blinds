# ── Mô hình thị giác (VLM) ─────────────────────────────────────
# Lấy khoá miễn phí tại https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model free để phát triển:
#   google/gemma-4-31b-it:free
#   google/gemma-4-26b-a4b-it:free
#   nvidia/nemotron-nano-12b-v2-vl:free
# Model của đề tài (trả phí, rất rẻ):
#   qwen/qwen3-vl-30b-a3b-instruct
VLM_MODEL=google/gemma-4-31b-it:free
VLM_MAX_TOKENS=1024
VLM_TEMPERATURE=0.3

# Chỉ dùng khi chưa có OPENROUTER_API_KEY
GOOGLE_API_KEY=

# ── Nhận dạng giọng nói ────────────────────────────────────────
# PhoWhisper của VinAI, bản đã convert sang CTranslate2.
# Đo bằng scripts/bench_stt.py: tiny đạt WER 2%, base thường 28,9%.
WHISPER_MODEL=diepho/PhoWhisper-tiny-ct2
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

# ── Cơ sở dữ liệu ──────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://sgbe_admin:sgbe_secret@localhost:5432/sgbe_vision

# ── Khác ───────────────────────────────────────────────────────
DEBUG=true
# Giới hạn nguồn gọi API khi đưa lên server thật, phân tách bằng dấu phẩy
CORS_ORIGINS=*

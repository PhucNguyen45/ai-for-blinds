{
  "$defs": {
    "ErrorInfo": {
      "additionalProperties": false,
      "description": "Lỗi vận hành. `message` không được chứa khóa API hoặc đường dẫn nội bộ.",
      "properties": {
        "code": {
          "enum": [
            "invalid_image",
            "config_error",
            "timeout",
            "http_error",
            "empty_response",
            "invalid_output",
            "invalid_input",
            "unknown"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "http_status": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Http Status"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "ErrorInfo",
      "type": "object"
    },
    "Meta": {
      "additionalProperties": false,
      "description": "Thông tin tái lập: mô hình, prompt, tham số, hiệu năng.",
      "properties": {
        "model": {
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "method": {
          "default": "B0",
          "enum": [
            "B0",
            "B1"
          ],
          "title": "Method",
          "type": "string"
        },
        "prompt_id": {
          "title": "Prompt Id",
          "type": "string"
        },
        "prompt_sha256": {
          "title": "Prompt Sha256",
          "type": "string"
        },
        "temperature": {
          "title": "Temperature",
          "type": "number"
        },
        "max_tokens": {
          "title": "Max Tokens",
          "type": "integer"
        },
        "finish_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finish Reason"
        },
        "latency_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Seconds"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "created_at_utc": {
          "format": "date-time",
          "title": "Created At Utc",
          "type": "string"
        }
      },
      "required": [
        "model",
        "prompt_id",
        "prompt_sha256",
        "temperature",
        "max_tokens",
        "created_at_utc"
      ],
      "title": "Meta",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "prompt_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Tokens"
        },
        "completion_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completion Tokens"
        }
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Kết quả một lượt hỏi đáp theo hình (bản nháp, cùng phiên bản hợp đồng với DescriptionResult).",
  "properties": {
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "image_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Image Id"
    },
    "status": {
      "enum": [
        "ok",
        "partial",
        "error"
      ],
      "title": "Status",
      "type": "string"
    },
    "answer_vi": {
      "default": "",
      "description": "Câu trả lời tiếng Việt, dùng được cho TTS (không Markdown).",
      "title": "Answer Vi",
      "type": "string"
    },
    "meta": {
      "anyOf": [
        {
          "$ref": "#/$defs/Meta"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "status"
  ],
  "title": "AnswerResult",
  "type": "object"
}

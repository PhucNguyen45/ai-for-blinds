# Nhà cung cấp VLM: openrouter (mặc định) hoặc google
VLM_PROVIDER=openrouter

# --- OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen3-vl-30b-a3b-instruct

# --- Google AI Studio (Gemini API, giao thức tương thích OpenAI) ---
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.8-flash  # tên model đổi nhanh: chạy `uv run python vlm/list_models.py --provider google` để xem danh sách
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Mức suy nghĩ gửi kèm (none/low/medium/high); để rỗng nếu model báo lỗi tham số này
GOOGLE_REASONING_EFFORT=none

# Sao chép file này thành backend/.env rồi sửa. KHÔNG đưa .env lên git.

# mock = dữ liệu giả, không cần mạng (để làm app) | openai = gọi mô hình thật
VLM_MODE=mock

# OpenRouter (giai đoạn 1)
VLM_BASE_URL=https://openrouter.ai/api/v1
VLM_API_KEY=sk-or-...
VLM_MODEL=qwen/qwen3-vl-30b-a3b-instruct

# Máy chủ on-premise chạy vLLM (giai đoạn 2): chỉ đổi 3 dòng trên, ví dụ
# VLM_BASE_URL=http://10.0.0.5:8001/v1
# VLM_API_KEY=
# VLM_MODEL=Qwen/Qwen3-VL-8B-Instruct

VLM_TIMEOUT=120
VLM_MAX_RETRIES=1
VLM_MAX_TOKENS=1024
VLM_TEMPERATURE=0.2

PROMPT_VERSION=v1
MAX_IMAGE_MB=10
IMAGE_MAX_SIDE=1600

STT_MODE=mock
MOCK_DELAY_SECONDS=1.0

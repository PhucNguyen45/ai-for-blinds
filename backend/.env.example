# Sao chép file này thành backend/.env rồi sửa. KHÔNG đưa .env lên git.

# mock   = dữ liệu giả, không cần mạng (để làm app)
# openai = backend tự gọi mô hình thật qua giao thức OpenAI (các dòng VLM_* bên dưới)
# ai     = gọi module AI của nhóm (ai/pipeline.py: cổng chất lượng ảnh + prompt + hợp đồng v0.1).
#          Cấu hình mô hình đọc từ ai/.env (VLM_PROVIDER, OPENROUTER_*, GOOGLE_*, LMSTUDIO_*), không dùng VLM_* ở đây.
#          Cài thêm: pip install -r backend/requirements-ai.txt
VLM_MODE=mock

# Thư mục module AI (mặc định <repo>/ai)
# AI_DIR=

# OpenRouter (giai đoạn 1)
VLM_BASE_URL=https://openrouter.ai/api/v1
VLM_API_KEY=sk-or-...
VLM_MODEL=qwen/qwen3-vl-30b-a3b-instruct

# Máy chủ on-premise chạy vLLM (giai đoạn 2): chỉ đổi 3 dòng trên, ví dụ
# VLM_BASE_URL=http://10.0.0.5:8001/v1
# VLM_API_KEY=
# VLM_MODEL=Qwen/Qwen3-VL-8B-Instruct

VLM_TIMEOUT=120
VLM_MAX_RETRIES=1
VLM_MAX_TOKENS=1024
VLM_TEMPERATURE=0.2

PROMPT_VERSION=v1
MAX_IMAGE_MB=10
IMAGE_MAX_SIDE=1600

STT_MODE=mock
MOCK_DELAY_SECONDS=1.0
